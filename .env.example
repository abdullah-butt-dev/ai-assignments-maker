# Server-side only. Set these in your Vercel project's Environment Variables
# (Project Settings -> Environment Variables), NOT in a committed .env file,
# and NOT prefixed with VITE_ -- that prefix is what leaked the old keys to
# the browser bundle. These are only ever read inside /api/*.js.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# For local development only: copy this file to .env.local (already gitignored)
# and `vercel dev` will pick it up. Do not commit real keys.
